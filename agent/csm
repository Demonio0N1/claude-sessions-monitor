#!/usr/bin/env bash
# csm — lanzador de sesiones de Claude Code monitorizadas (dentro de tmux).
# La sesión sobrevive a cortes de SSH/terminal: al volver, usa 'csm attach'.
# Uso:
#   csm [args de claude...]   crea/reusa la sesión tmux de este directorio y abre Claude
#                             (si hay conversación previa aquí, la retoma con --continue)
#   csm --new [args...]       ignora la conversación previa y empieza de cero
#   csm ls                    lista las sesiones csm
#   csm attach [nombre]       vuelve a una sesión existente (sin nombre: entra
#                             directo si solo hay una)
#   csm help                  esta ayuda
set -euo pipefail

die() { echo "csm: $*" >&2; exit 1; }

command -v tmux >/dev/null 2>&1 || die "tmux no está instalado (macOS: brew install tmux | Debian: sudo apt install tmux)"

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; }

# ¿Claude guardó conversaciones para este directorio? (~/.claude/projects/<cwd codificado>)
# La codificación reemplaza todo carácter no alfanumérico por '-'; probamos la variante
# por caracteres (locale UTF-8) y por bytes (LC_ALL=C) para cubrir acentos.
has_previous_conversation() {
  local enc1 enc2 d
  enc1=$(printf '%s' "$PWD" | sed 's/[^a-zA-Z0-9]/-/g' 2>/dev/null || true)
  enc2=$(printf '%s' "$PWD" | LC_ALL=C sed 's/[^a-zA-Z0-9]/-/g')
  for d in "$HOME/.claude/projects/$enc1" "$HOME/.claude/projects/$enc2"; do
    [ -n "$d" ] && [ -d "$d" ] && ls "$d"/*.jsonl >/dev/null 2>&1 && return 0
  done
  return 1
}

session_base() {
  local base
  base=$(basename "$PWD" | tr -c 'a-zA-Z0-9_-' '-' | sed -e 's/^-*//' -e 's/-*$//')
  echo "csm-${base:-session}"
}

attach_to() {
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$1"
  else
    # -d: desengancha clientes viejos (p. ej. un SSH que se cortó sin cerrar);
    # si no, dejan la ventana congelada o encogida al reconectarse.
    tmux attach -d -t "$1"
  fi
}

# Arranca el servidor tmux fuera del scope de la sesión SSH cuando es posible:
# en Linux, si logind mata los procesos al cortarse la conexión
# (KillUserProcesses=yes), un servidor tmux nacido dentro del SSH moriría con él.
start_detached() {
  if [ "$(uname -s)" = "Linux" ] && command -v systemd-run >/dev/null 2>&1 \
    && ! tmux has-session 2>/dev/null; then
    systemd-run --user --scope --quiet -- "$@" 2>/dev/null && return 0
  fi
  "$@"
}

case "${1:-}" in
  ls)
    tmux list-sessions -F '#{session_name}  (#{session_windows} win, creada #{t:session_created})' 2>/dev/null \
      | grep '^csm-' || echo "No hay sesiones csm."
    exit 0
    ;;
  attach)
    if [ -n "${2:-}" ]; then
      attach_to "$2"
      exit 0
    fi
    # sin nombre: si hay una sola sesión csm, entra directo; si hay varias, lista
    # (bucle read en vez de mapfile: el bash de macOS es 3.2)
    csm_sessions=()
    while IFS= read -r s; do csm_sessions+=("$s"); done < <(
      tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^csm-' || true
    )
    case "${#csm_sessions[@]}" in
      0) die "no hay sesiones csm activas" ;;
      1)
        echo "Entrando a '${csm_sessions[0]}'..."
        attach_to "${csm_sessions[0]}"
        ;;
      *)
        echo "Hay varias sesiones csm; elige con 'csm attach <nombre>':"
        tmux list-sessions -F '  #{session_name}  (#{pane_current_path})' 2>/dev/null | grep 'csm-'
        ;;
    esac
    exit 0
    ;;
  help | -h | --help)
    usage
    exit 0
    ;;
esac

# csm [args...] → crea o reusa la sesión de este directorio
new_flag=0
claude_args=()
for a in "$@"; do
  case "$a" in
    --new) new_flag=1 ;;
    *) claude_args+=("$a") ;;
  esac
done

base=$(session_base)
name="$base"
i=2
# si el nombre está tomado por OTRO directorio (mismo basename), busca sufijo libre
while tmux has-session -t "=$name" 2>/dev/null; do
  existing=$(tmux display-message -p -t "$name" '#{pane_current_path}' 2>/dev/null || echo '')
  if [ "$existing" = "$PWD" ]; then
    echo "Reconectando a la sesión existente '$name'..."
    attach_to "$name"
    exit 0
  fi
  name="$base-$i"
  i=$((i + 1))
done

cmd=(claude)
if [ "$new_flag" -eq 0 ] && has_previous_conversation; then
  cmd=(claude --continue)
  echo "Conversación previa detectada: se retoma con --continue (usa 'csm --new' para empezar de cero)."
fi

echo "Creando sesión '$name' en $PWD ..."
# Claude va envuelto en sh -c para NO ser hijo directo de tmux: si fuera hijo
# directo, tmux le enviaría SIGCONT automáticamente y la pausa (SIGSTOP) del
# monitor no se sostendría.
start_detached tmux new-session -d -s "$name" -c "$PWD" sh -c '"$@"; :' csm-wrap "${cmd[@]}" ${claude_args+"${claude_args[@]}"}
attach_to "$name"
